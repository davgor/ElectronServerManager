{
  "name": "electron-server-manager",
  "version": "1.0.35",
  "description": "Electron Server Manager Application",
  "main": "dist/main/main.js",
  "homepage": "./",
  "repository": {
    "type": "git",
    "url": "https://github.com/davgor/ElectronServerManager.git"
  },
  "author": {
    "name": "Electron Server Manager Contributors",
    "email": "davgor4@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run dev",
    "electron": "wait-on http://localhost:5173 && electron .",
    "dev": "npm run electron-build && npm run rebuild:native && cross-env NODE_ENV=development concurrently \"npm run electron\" \"npm run dev:renderer\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "electron-build": "tsc -p tsconfig.main.json",
    "electron-dev": "tsc -p tsconfig.main.json --watch",
    "dist": "npm run build && npm run electron-build && npm run rebuild:native && electron-builder",
    "dist-dev": "npm run build && npm run electron-build && npm run rebuild:native && electron-builder --dir",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "verify:native:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./scripts/verify-better-sqlite3-electron.cjs",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "deadcode": "node scripts/deadcode-check.cjs",
    "deadcode:refresh": "node scripts/deadcode-refresh.cjs",
    "fireguard": "node fireguard/bin/fireguard.mjs",
    "format": "prettier --write src fireguard .fireguardrc.json",
    "format:check": "prettier --check src fireguard .fireguardrc.json",
    "type-check": "tsc --noEmit && tsc --noEmit -p fireguard/tsconfig.json",
    "pretest": "npm run electron-build && npm run rebuild:native:node",
    "test": "jest",
    "test:watch": "jest --watch",
    "pretest:coverage": "npm run pretest",
    "test:coverage": "jest --coverage",
    "test:diff-coverage": "jest --coverage --silent && node .github/scripts/diff-coverage-gate.cjs",
    "audit:cve": "node scripts/audit-cve.cjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.10",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.17.0",
    "esbuild": "0.27.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^16.4.0",
    "minimatch": "^10.2.6",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.0",
    "ts-prune": "^0.10.3",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vite": "^7.3.6",
    "wait-on": "^7.0.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "^3.1.8",
    "global-agent": "^4.1.3",
    "js-yaml@4": "4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "tar": "^7.5.22",
    "ts-prune": {
      "ts-morph": "27.0.2"
    },
    "undici": "^6.29.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "fireguard/**/*.ts": [
      "prettier --write"
    ]
  }
}
